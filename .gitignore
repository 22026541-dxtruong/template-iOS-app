# xcodegen output (regenerated from project.yml — don't commit)
ios/MyApp.xcodeproj/

# Secrets — copy Secrets.swift.example → Secrets.swift and never commit
ios/MyApp/Secrets.swift

# Firebase config — drop GoogleService-Info.plist alongside the source files
# but never commit it (contains your API keys)
ios/MyApp/GoogleService-Info.plist

# IDE
.idea/

# Logs
*.log